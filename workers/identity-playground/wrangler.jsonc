{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mpp-identity-playground",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The page is static assets; the paid API and the email issuer always reach the Worker.
  "assets": {
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/playground/identity/api/*",
      "/playground/identity/issuer/*"
    ]
  },
  // Workers AI writes the haiku. Without it (local dev without a Cloudflare login),
  // the Worker falls back to ANTHROPIC_API_KEY, then to a built-in haiku.
  "ai": { "binding": "AI" },
  // One Durable Object store holds spent payment credentials and pending email codes.
  "durable_objects": {
    "bindings": [{ "name": "MPPX_STORE", "class_name": "MppxStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MppxStore"] }],
  "observability": { "enabled": true },
  // mpp.dev/playground/identity rewrites here: attestations are bound to mpp.dev, and the
  // caller's IP comes from Vercel's X-Real-IP (Cloudflare only sees Vercel's).
  "vars": { "PUBLIC_ORIGIN": "https://mpp.dev", "TRUST_PROXY_IP": "true" }
}
