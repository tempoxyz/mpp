{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mpp-session-playground",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The page is static assets; the paid API always reaches the Worker.
  "assets": {
    "not_found_handling": "404-page",
    "run_worker_first": ["/playground/session/api/*"]
  },
  // Workers AI writes the story. Without it (local dev without a Cloudflare login), the Worker
  // streams a built-in story.
  "ai": { "binding": "AI" },
  // One Durable Object store holds session channels and spent credentials.
  "durable_objects": {
    "bindings": [{ "name": "MPPX_STORE", "class_name": "MppxStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MppxStore"] }],
  "observability": { "enabled": true }
}
