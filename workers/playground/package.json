{
  "name": "mpp-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/nest-assets.mjs && node scripts/prerender-html.ts",
    "check:types": "tsgo -b",
    "check": "pnpm check:types && pnpm check:samples && pnpm build",
    "check:samples": "pnpm --workspace-root exec vitest run scripts/check-identity-playground-samples.test.ts scripts/check-session-playground-samples.test.ts",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "vite dev",
    "pubkeys": "tsx src/identity/pubkeys.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "accounts": "0.21.1",
    "mppx": "0.0.0-main-20261110013608",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "viem": "^2.57.17",
    "wagmi": "^3.7.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@pierre/diffs": "^1.6.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}
